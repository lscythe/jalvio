amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["kempt"] {
        fix = "kempt hook"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["check-conventional-commit"] = Builtins.check_conventional_commit
            ["check-commit-scope"] {
                check = "python3 .github/scripts/commit_scope.py {{commit_msg_file}}"
            }
        }
    }
    ["pre-push"] {
        steps = new Mapping<String, Step> {
            ["gradle-check"] {
                check = "./gradlew checkModuleBoundaries testAndroidHostTest"
            }
        }
    }
}
